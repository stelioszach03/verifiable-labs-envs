# Copy to .env.local and fill in. Never commit .env.local.
# Stage A only requires DATABASE_URL and VLABS_API_KEY_HASH_PEPPER.

# ── Required ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vlabs:vlabs@localhost:5433/vlabs
VLABS_API_KEY_HASH_PEPPER=replace-me-with-32-bytes-of-base64-entropy

# ── Optional ─────────────────────────────────────────────────────────
VLABS_LOG_LEVEL=INFO
VLABS_ENVIRONMENT=dev

# ── Stage B: Stripe (TEST MODE ONLY until Delaware C-corp resolves) ─
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Created via `scripts/create_stripe_products.py` (run once with sk_test_)
STRIPE_PRICE_ID_PRO=price_replace_me
STRIPE_PRICE_ID_TEAM=price_replace_me
STRIPE_PRICE_ID_PRO_OVERAGE=price_replace_me
STRIPE_PRICE_ID_TEAM_OVERAGE=price_replace_me

# Created when you add the webhook endpoint in Stripe Dashboard.
# For local dev: `stripe listen --forward-to localhost:8000/v1/billing/webhook`
# prints the whsec_ secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where the user lands after Checkout / Portal flows.
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard/billing
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/dashboard/billing?status=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/dashboard/billing?status=cancel

# ── Stage B: Clerk (dashboard auth) ─────────────────────────────────
# Get from https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Your Clerk instance issuer URL (visible in dashboard -> JWT templates)
# e.g. https://romantic-dolphin-12.clerk.accounts.dev
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=

# ── Stage C: observability + Redis + admin + Cloudflare ────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Upstash Redis REST API. When both vars are set, ratelimit.py uses
# Redis as the storage backend (multi-instance safe). When unset, falls
# back to in-memory (single-instance only). Local dev: leave unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# BetterStack uptime + status page (set during deploy, not for local dev).
BETTERSTACK_API_TOKEN=

# Cloudflare DNS automation token (only the deploy script reads this).
CLOUDFLARE_API_TOKEN=

# Clerk user IDs allowed to hit /v1/admin/*. Comma-separated.
# Get from Clerk dashboard -> Users -> click your user -> "User ID".
VLABS_ADMIN_CLERK_IDS=

# Stripe billing kill-switch. While the Delaware C-corp registration is
# pending, set to false so /v1/billing/* return 503 and the webhook
# short-circuits. Set to true once Stripe live mode is approved.
VLABS_BILLING_ENABLED=false

# ── Phase 23: vlabs-data (R2 + LLM-key encryption + worker pool) ────
# Cloudflare R2 (S3-compatible). Production deploy needs all five.
# Local dev / tests run in LOCAL_FAKE_R2 mode (writes to /tmp/r2-fake)
# so these can stay empty until production deploy.
VLABS_R2_ACCOUNT_ID=
VLABS_R2_ACCESS_KEY_ID=
VLABS_R2_SECRET_ACCESS_KEY=
VLABS_R2_BUCKET_NAME=vlabs-datasets
VLABS_R2_PUBLIC_URL=
VLABS_R2_ENDPOINT_URL=

# Symmetric key for Fernet encryption of dataset_jobs.llm_api_key_encrypted.
# Treat as a Fly secret. Generate via:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
VLABS_DATA_LLM_KEY_ENCRYPTION=

# Worker pool (D4-A: in-app worker pool).
VLABS_DATA_WORKER_POOL_SIZE=2
VLABS_DATA_CHECKPOINT_EVERY_N=1000
VLABS_DATA_MAX_TUPLES_PER_JOB=100000

# Local fake-R2 toggle. Set to true in CI / local dev so storage writes
# go to /tmp/r2-fake/<bucket>/<key> instead of Cloudflare. Leave empty
# in production.
VLABS_LOCAL_FAKE_R2=
